# ============================================================
# Clinic Appointment Management System — environment variables
# ============================================================
#
# This file documents every environment variable used across the project.
# It is not read directly by either app — copy the relevant section into:
#   backend/.env    (read by FastAPI / pydantic-settings)
#   frontend/.env   (read by Vite — only VITE_-prefixed vars are exposed)
#
# Never commit backend/.env or frontend/.env — only this example file.

# ------------------------------------------------------------
# Backend (FastAPI) — copy into backend/.env
# ------------------------------------------------------------

APP_NAME="Clinic Appointment Management System"
ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://clinic_user:clinic_password@localhost:5432/clinic_db

# JWT auth. Generate a real secret for anything beyond local development,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Default appointment length, used only if a doctor hasn't configured one.
DEFAULT_SLOT_DURATION_MINUTES=30

# ------------------------------------------------------------
# Frontend (Vite / React) — copy into frontend/.env
# ------------------------------------------------------------

# Left unset by default: the Vite dev server proxies /api to the backend
# (see frontend/vite.config.js), so this is only needed if the frontend
# is served separately from the backend (e.g. in production).
# VITE_API_BASE_URL=/api
